---
import Article from "../../layouts/Article.astro";
import { insights } from "../../data/content.js";
import { SITE } from "../../data/seo.js";
export function getStaticPaths() {
  return insights.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const others = insights.filter((x) => x.slug !== a.slug);
const article = {
  "@type": "Article",
  headline: a.title,
  description: a.teaser,
  author: { "@id": `${SITE}/#org` },
  publisher: { "@id": `${SITE}/#org` },
  mainEntityOfPage: `${SITE}/insights/${a.slug}/`,
  inLanguage: "en",
  dateModified: "2026-10-09",
};
---
<Article
  title={`${a.title} | TellRep Insights`}
  description={`${a.teaser} A TellRep insight for IVD and medical device manufacturers entering Switzerland.`}
  eyebrow={a.tag}
  h1={a.title}
  lead={a.teaser}
  type="article"
  crumbs={[["Home", "/"], ["Insights", "/#insights"], [a.title, `/insights/${a.slug}/`]]}
  schema={[article]}
  note={`Sources: ${a.sources}. Status October 2026. Not legal advice.`}
  related={[...others.map((o) => ({ href: `/insights/${o.slug}/`, label: o.title, tag: o.tag })), { href: "/ch-rep/", label: "CH-REP guide", tag: "Guide" }]}
>
  <Fragment set:html={a.body} />
</Article>
