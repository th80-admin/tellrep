---
import Article from "../layouts/Article.astro";
import { faqSchema } from "../data/seo.js";
const faq = [
  { q: "Is swissdamed device registration mandatory?", a: "Yes. Since 1 July 2026 devices, systems and procedure packs placed on the Swiss market are registered in the swissdamed UDI Devices module. Devices placed on the market after 1 July 2026 have a transition period until 31 December 2026. Devices involved in a serious incident, a field safety corrective action or a trend report must be registered immediately." },
  { q: "Who registers devices in swissdamed?", a: "The manufacturer or its Swiss authorised representative (CH-REP). Economic operators first register in the Actors module and receive a Swiss Single Registration Number (CHRN)." },
  { q: "What does swissdamed registration cost?", a: "Swissmedic charges CHF 200 for the first UDI-DI on the market and CHF 20 for each further one, capped at CHF 10,000 per year." },
  { q: "Does EUDAMED registration count for Switzerland?", a: "No. Switzerland has no access to EUDAMED. Manufacturers selling in both markets keep two registrations in parallel." },
];
---
<Article
  title="swissdamed Registration: Deadlines, CHRN, Fees | TellRep"
  description="swissdamed device registration is mandatory since 1 July 2026, with a transition until 31 December 2026. Actors module, CHRN, UDI Devices module, fees and how your CH-REP registers for you."
  eyebrow="swissdamed guide"
  h1="swissdamed registration: what manufacturers need to do by 31 December 2026"
  lead="swissdamed is the Swiss medical devices database run by Swissmedic. Your CH-REP needs a CHRN, and your devices need to be registered. Here is how it works."
  crumbs={[["Home", "/"], ["swissdamed registration", "/swissdamed-registration/"]]}
  schema={[faqSchema(faq)]}
  note="Sources: Swissmedic, swissdamed registration obligation; IvDO and MedDO. Status October 2026. Not legal advice."
  related={[
    { href: "/ch-rep/", label: "CH-REP guide", tag: "Guide" },
    { href: "/insights/swissdamed-and-eudamed/", label: "swissdamed and EUDAMED", tag: "Insight" },
    { href: "/ch-rep/eu-manufacturers/", label: "CH-REP for EU manufacturers", tag: "By origin" },
  ]}
>
  <div class="facts3">
    <div><strong>1 Jul 2026</strong><span>device registration mandatory</span></div>
    <div><strong>31 Dec 2026</strong><span>end of transition for devices on the market</span></div>
    <div><strong>CHF 200</strong><span>first UDI-DI, then CHF 20 each, max. CHF 10,000 per year</span></div>
  </div>

  <h2>Two modules, two steps</h2>
  <ol>
    <li><strong>Actors module.</strong> Swiss economic operators, including your CH-REP and importer, register and receive a Swiss Single Registration Number (CHRN). Your CH-REP mandate is notified here.</li>
    <li><strong>UDI Devices module.</strong> Devices, systems and procedure packs are registered with their UDI data. This replaces the earlier notifications, including those for IVDs of all risk classes.</li>
  </ol>

  <h2>Deadlines</h2>
  <div class="tbl"><table>
    <thead><tr><th>Situation</th><th>Register by</th></tr></thead>
    <tbody>
      <tr><td>Devices placed on the market after 1 July 2026</td><td class="num">31 Dec 2026</td></tr>
      <tr><td>Devices involved in a serious incident, field safety corrective action or trend report</td><td>Immediately</td></tr>
    </tbody>
  </table></div>

  <h2>How TellRep handles swissdamed for you</h2>
  <ul>
    <li>Registration of TellRep as your CH-REP and notification of the mandate.</li>
    <li>Collection and check of your UDI data, then device registration in the UDI Devices module.</li>
    <li>Payment of the Swissmedic fees on your behalf, passed on at cost, if you wish.</li>
    <li>Updates whenever your portfolio changes.</li>
  </ul>

  <h2>Frequently asked questions</h2>
  {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
</Article>
