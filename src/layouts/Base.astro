---
import "@fontsource/schibsted-grotesk/500.css";
import "@fontsource/schibsted-grotesk/600.css";
import "@fontsource/schibsted-grotesk/700.css";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { org } from "../data/seo.js";
interface Props { title?: string; description?: string; schema?: object[]; type?: string; noindex?: boolean }
const {
  title = "CH-REP Switzerland for IVD and Medical Devices | TellRep",
  description = "TellRep is your CH-REP, the Swiss authorised representative for IVDs and medical devices: mandate, swissdamed registration, labelling and vigilance.",
  schema = [],
  type = "website",
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : Astro.url.pathname + "/";
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const graph = { "@context": "https://schema.org", "@graph": [org, ...schema] };
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:site_name" content="TellRep" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_GB" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  <script is:inline>document.documentElement.classList.add("js")</script>
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <a href="/" class="brand" aria-label="TellRep home"><Logo id="hd" height={28} /></a>
      <nav aria-label="Main">
        <a href="/#services">Services</a>
        <a href="/ch-rep/">CH-REP guide</a>
        <a href="/#insights">Insights</a>
        <a href="/#about">About</a>
      </nav>
      <a class="btn btn-ink cta" href="/#analysis">Free CH-REP analysis</a>
    </div>
  </header>

  <main id="top"><slot /></main>

  <footer>
    <div class="wrap foot">
      <div class="fcol">
        <Logo id="ft" tagline height={56} />
        <p>For in vitro diagnostics and medical devices.</p>
      </div>
      <div class="fcol">
        <span class="label">Contact</span>
        <span class="mono">info@tellrep.ch</span>
        <span>[Registered address follows on incorporation]</span>
      </div>
      <div class="fcol">
        <span class="label">Guides</span>
        <a href="/ch-rep/">What is a CH-REP?</a>
        <a href="/swissdamed-registration/">swissdamed registration</a>
        <a href="/#requirements">Swiss market access</a>
      </div>
      <div class="fcol">
        <span class="label">CH-REP for</span>
        <a href="/ch-rep/china/">China</a>
        <a href="/ch-rep/korea/">Korea</a>
        <a href="/ch-rep/india/">India</a>
        <a href="/ch-rep/turkiye/">Türkiye</a>
        <a href="/ch-rep/eu-manufacturers/">EU manufacturers</a>
      </div>
      <div class="fcol">
        <span class="label">Legal</span>
        <a href="/imprint/">Imprint</a>
        <a href="/privacy/">Privacy</a>
      </div>
    </div>
    <div class="wrap fine">© {year} TellRep. Swiss authorised representative under Art. 44 IvDO and Art. 51 MedDO.</div>
  </footer>

  <script>
    import "../scripts/motion.js";
  </script>
</body>
</html>

<style>
  header.top {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50;
    background: color-mix(in srgb, var(--studio-0) 82%, transparent);
    backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px);
  }
  .bar { display: flex; align-items: center; gap: 28px; min-height: 68px; }
  .brand { display: flex; text-decoration: none; }
  nav { display: flex; gap: 26px; margin-left: auto; font-size: 14.5px; font-weight: 500; }
  nav a { text-decoration: none; color: var(--slate); transition: color .2s; }
  nav a:hover { color: var(--ink); }
  .cta { padding: 11px 16px; font-size: 14px; }
  @media (max-width: 880px) { nav { display: none; } .cta { margin-left: auto; } }

  footer { border-top: 1px solid var(--hairline); padding-block: 64px 40px; color: var(--slate); font-size: 14.5px; background: var(--studio-0); }
  .foot { display: grid; grid-template-columns: 1.5fr 1.1fr 1fr .8fr .7fr; gap: 32px; }
  .fcol { display: grid; gap: 8px; align-content: start; }
  .fcol a { text-decoration: none; } .fcol a:hover { color: var(--ink); }
  .fcol .mono { color: var(--ink); font-size: 14px; }
  .fine { margin-top: 48px; font-size: 12.5px; color: var(--mist); }
  @media (max-width: 820px) { .foot { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .foot { grid-template-columns: 1fr; } }
</style>
