---
// Long-form page: breadcrumb, H1, lead, body slot, CTA and related links.
import Base from "./Base.astro";
import { breadcrumb } from "../data/seo.js";
interface Props {
  title: string; description: string; h1: string; lead?: string; eyebrow?: string;
  crumbs: [string, string][]; schema?: object[]; type?: string; note?: string;
  related?: { href: string; label: string; tag?: string }[];
}
const { title, description, h1, lead, eyebrow, crumbs, schema = [], type = "website", note, related = [] } = Astro.props;
---
<Base title={title} description={description} type={type} schema={[breadcrumb(crumbs), ...schema]}>
  <article class="wrap art">
    <nav class="crumbs" aria-label="Breadcrumb">
      {crumbs.map(([name, path], i) => i < crumbs.length - 1 ? <><a href={path}>{name}</a><span aria-hidden="true">/</span></> : <span aria-current="page">{name}</span>)}
    </nav>
    {eyebrow && <span class="label">{eyebrow}</span>}
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
    <div class="body"><slot /></div>
    {note && <p class="srcline mono">{note}</p>}
    <div class="cta">
      <div><h3>Not sure what applies to your devices?</h3><p>Get a free CH-REP analysis with your personal Swiss to-do list.</p></div>
      <a class="btn btn-red" href="/#analysis">Free CH-REP analysis</a>
    </div>
    {related.length > 0 && (
      <div class="more">
        {related.map((o) => (<a href={o.href}>{o.tag && <span class="label">{o.tag}</span>}<b>{o.label}</b></a>))}
      </div>
    )}
  </article>
</Base>

<style>
  .art { max-width: 800px; padding-block: clamp(40px, 6vw, 88px); display: grid; gap: 18px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 13.5px; color: var(--slate); }
  .crumbs a { color: var(--slate); text-decoration: none; } .crumbs a:hover { color: var(--ink); }
  .crumbs [aria-current] { color: var(--ink); }
  h1 { font-size: clamp(36px, 5vw, 56px); line-height: 1.04; letter-spacing: -0.03em; text-wrap: balance; }
  .body { display: grid; gap: 18px; margin-top: 12px; font-size: 17px; line-height: 1.65; }
  .body :global(h2) { font-size: clamp(24px, 2.6vw, 30px); line-height: 1.15; letter-spacing: -0.02em; margin-top: 22px; text-wrap: balance; }
  .body :global(h3) { font-size: 20px; margin-top: 8px; }
  .body :global(ul), .body :global(ol) { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; }
  .body :global(.facts3) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .body :global(.facts3 div) { background: var(--studio-0); border: 1px solid var(--hairline); border-radius: var(--r-md); padding: 18px; display: grid; gap: 4px; }
  .body :global(.facts3 strong) { font-family: var(--display); font-size: 28px; letter-spacing: -0.02em; }
  .body :global(.facts3 span) { font-size: 14px; color: var(--slate); line-height: 1.4; }
  .body :global(.tbl) { overflow-x: auto; background: var(--studio-0); border: 1px solid var(--hairline); border-radius: var(--r-md); }
  .body :global(table) { width: 100%; border-collapse: collapse; font-size: 14.5px; line-height: 1.4; }
  .body :global(th), .body :global(td) { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .body :global(th) { font-weight: 600; background: var(--studio-50); }
  .body :global(tr:last-child td) { border-bottom: 0; }
  .body :global(.num) { font-family: var(--mono); font-size: 13.5px; white-space: nowrap; }
  .body :global(.src) { font-size: 14px; color: var(--slate); }
  .body :global(.points) { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .body :global(.points div) { border: 1px solid var(--hairline); border-radius: var(--r-md); padding: 20px; display: grid; gap: 6px; align-content: start; }
  .body :global(.points b) { font-size: 17px; }
  .body :global(.points p) { color: var(--slate); font-size: 15px; line-height: 1.55; }
  .body :global(details) { border: 1px solid var(--hairline); border-radius: var(--r-md); padding: 16px 18px; }
  .body :global(summary) { cursor: pointer; font-weight: 600; }
  .body :global(details p) { margin-top: 10px; color: var(--slate); }
  .srcline { font-size: 12.5px; color: var(--slate); padding-top: 14px; margin-top: 10px; }
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; background: var(--studio-0); border: 1px solid var(--hairline); border-radius: var(--r-lg); box-shadow: var(--shadow-2); padding: 26px; margin-top: 14px; }
  .cta p { color: var(--slate); }
  .more { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-top: 8px; }
  .more a { text-decoration: none; display: grid; gap: 6px; background: var(--studio-50); border-radius: var(--r-md); padding: 18px; }
  @media (max-width: 640px) { .body :global(.facts3), .body :global(.points) { grid-template-columns: 1fr; } }
</style>
