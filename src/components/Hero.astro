---
import Apple from "./Apple.astro";
const chips = [
  { t: "Art. 44 IvDO", x: -300, y: -40 },
  { t: "swissdamed", x: -250, y: -150 },
  { t: "CHRN", x: -120, y: -215 },
  { t: "PRRC", x: 120, y: -215 },
  { t: "DE · FR · IT", x: 250, y: -150 },
  { t: "Vigilance", x: 300, y: -40 },
];
---
<section class="hero">
  <div class="wrap copy">
    <span class="label" data-reveal>Swiss authorised representative · IVD and medical devices</span>
    <h1 data-reveal>Your representative in Switzerland.<br /><span class="red">On target.</span></h1>
    <p class="lead" data-reveal>Switzerland is no longer part of the EU device system. Every manufacturer without a Swiss registered office needs a Swiss authorised representative before selling here. TellRep takes that role, run by people who have spent fourteen years in Swiss laboratory diagnostics.</p>
    <div class="actions" data-reveal>
      <a class="btn btn-red" href="#analysis">Get your free analysis</a>
      <a class="btn btn-quiet" href="#requirements">What Switzerland requires</a>
    </div>
  </div>

  <div class="stage" aria-hidden="true">
    {chips.map((c, i) => (
      <span class="chip" style={`--x:${c.x}px;--y:${c.y}px;--d:${i * 0.08}s`}>{c.t}</span>
    ))}
    <div class="apple-wrap">
      <div class="apple-float">
        <Apple id="hero" size={190} />
        <svg class="arrow" viewBox="0 0 300 24" width="300" height="24">
          <line x1="10" y1="12" x2="300" y2="12" stroke="#161B20" stroke-width="3" stroke-linecap="round" />
          <path d="M10 12 L0 3 M10 12 L0 21 M24 12 L14 3 M24 12 L14 21 M38 12 L28 3 M38 12 L28 21" stroke="#161B20" stroke-width="3" stroke-linecap="round" fill="none" />
        </svg>
      </div>
      <div class="floor"></div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(48px, 6vw, 80px) 0; text-align: center; overflow: hidden; }
  .copy { display: grid; justify-items: center; gap: 22px; }
  h1 { font-size: clamp(40px, 6.2vw, 78px); line-height: 1.0; letter-spacing: -0.035em; max-width: 14ch; }
  .lead { margin-inline: auto; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 6px; }

  .stage { position: relative; height: clamp(360px, 42vw, 460px); margin-top: clamp(24px, 4vw, 48px); display: grid; place-items: end center; }
  .apple-wrap { position: relative; width: 190px; height: 300px; display: grid; place-items: end center; }
  .apple-float { position: relative; z-index: 2; filter: drop-shadow(0 28px 32px rgba(110, 8, 25, 0.18)); animation: float 6s ease-in-out infinite; margin-bottom: 70px; }
  .floor { position: absolute; bottom: 40px; width: 170px; height: 26px; border-radius: 50%; background: radial-gradient(closest-side, rgba(22, 27, 32, 0.18), rgba(22, 27, 32, 0)); animation: floor 6s ease-in-out infinite; }
  .arrow { position: absolute; z-index: 3; left: 50%; top: 56%; width: 300px; height: 24px; margin-top: -12px; transform: translateX(-282px); }
  @keyframes float { 0%, 100% { transform: translateY(0) } 50% { transform: translateY(-10px) } }
  @keyframes floor { 0%, 100% { transform: scale(1); opacity: 1 } 50% { transform: scale(.9); opacity: .75 } }

  .chip { position: absolute; left: 50%; bottom: 210px; transform: translate(calc(-50% + var(--x)), var(--y)); font-family: var(--mono); font-size: 13px; font-weight: 500; background: var(--studio-0); border: 1px solid var(--hairline); border-radius: 999px; padding: 7px 13px; box-shadow: var(--shadow-2); white-space: nowrap; color: var(--ink); }
  @media (max-width: 720px) {
    .stage { height: 430px; margin-top: 40px; }
    .chip:first-child, .chip:nth-child(6) { display: none; }
    .chip { font-size: 11.5px; padding: 5px 10px; transform: translate(calc(-50% + var(--x) * 0.5), calc(var(--y) * 0.8)); }
    .arrow { width: 220px; transform: translateX(-206px); }
  }
  @media (prefers-reduced-motion: reduce) { .apple-float, .floor { animation: none; } }
</style>
