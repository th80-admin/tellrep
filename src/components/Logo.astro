---
interface Props { tagline?: boolean; id?: string; height?: number }
const { tagline = false, id = "lg", height = 30 } = Astro.props;
const vb = tagline ? "0 0 214 78" : "0 0 214 60";
const body = "M12 7.2 C9.4 5.3 4.6 6.1 4.6 11.3 C4.6 16.4 8.2 21.2 10.9 20.7 C11.6 20.6 12 20.3 12 20.3 C12 20.3 12.4 20.6 13.1 20.7 C15.8 21.2 19.4 16.4 19.4 11.3 C19.4 6.1 14.6 5.3 12 7.2 Z";
---
<svg class="logo" viewBox={vb} style={`height:${height}px;width:auto;display:block`} role="img" aria-label="TellRep, Swiss Authorised Representative">
  <defs>
    <radialGradient id={`${id}-b`} cx="0.36" cy="0.32" r="0.78"><stop offset="0" stop-color="#F0475F" /><stop offset="0.45" stop-color="#C8102E" /><stop offset="1" stop-color="#7E0A1F" /></radialGradient>
    <radialGradient id={`${id}-s`} cx="0.5" cy="1" r="0.6"><stop offset="0" stop-color="#4A0613" stop-opacity="0.45" /><stop offset="1" stop-color="#4A0613" stop-opacity="0" /></radialGradient>
  </defs>
  <text x="0" y="52" font-family="'Helvetica Neue',Helvetica,Arial,sans-serif" font-size="54" letter-spacing="-1" fill="#161B20"><tspan font-weight="700">Tell</tspan><tspan font-weight="400">Rep</tspan></text>
  <g transform="translate(180 -1.5) scale(1.25)">
    <path d={body} fill={`url(#${id}-b)`} />
    <path d={body} fill={`url(#${id}-s)`} />
    <ellipse cx="8.4" cy="9.6" rx="1.7" ry="2.7" transform="rotate(28 8.4 9.6)" fill="#fff" opacity="0.55" />
    <path d="M12 7.4 C12 5.6 12.5 4.2 13.6 3.1" fill="none" stroke="#161B20" stroke-width="1.1" stroke-linecap="round" />
    <path d="M13.1 4.6 C14.6 2.6 17.4 2.3 18.6 3.0 C17.6 4.9 15.2 5.9 13.1 4.6 Z" fill="#161B20" />
  </g>
  {tagline && <text x="1" y="74.5" textLength="181" lengthAdjust="spacing" font-family="'Helvetica Neue',Helvetica,Arial,sans-serif" font-size="9" font-weight="500" fill="#56616C">SWISS AUTHORISED REPRESENTATIVE</text>}
</svg>
