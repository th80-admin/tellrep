---
import Apple from "./Apple.astro";
const origins = [
  { c: "CN", n: "China", a: 200 }, { c: "KR", n: "Korea", a: 172 }, { c: "IN", n: "India", a: 144 },
  { c: "TR", n: "Türkiye", a: 116 }, { c: "US", n: "USA", a: 64 }, { c: "IT", n: "Italy", a: 36 },
  { c: "FR", n: "France", a: 8 }, { c: "DE", n: "Germany", a: -20 },
];
const R = 230;
const pts = origins.map((o) => {
  const rad = (o.a * Math.PI) / 180;
  return { ...o, x: Math.round(Math.cos(rad) * R), y: Math.round(-Math.sin(rad) * R * 0.78) };
});
---
<section class="band origins" data-origins>
  <div class="wrap">
    <div class="head center">
      <span class="label" data-reveal>From anywhere</span>
      <h2 class="big" data-reveal>Every road into Switzerland runs through one Swiss address.</h2>
      <p class="lead" data-reveal>EU manufacturers need a CH-REP just like manufacturers from Asia or the Americas. We represent IVD and medical device makers from all over the world, in English, German and Italian.</p>
    </div>
    <div class="map" aria-hidden="true">
      <svg class="lines" viewBox="-360 -262 720 340" preserveAspectRatio="xMidYMid meet">
        {pts.map((p) => (<path class="ln" d={`M${p.x} ${p.y} Q ${p.x * 0.35} ${p.y * 0.2 - 30} 0 0`} />))}
      </svg>
      {pts.map((p) => (
        <span class="node" style={`--x:${p.x}px;--y:${p.y}px`}><b class="mono">{p.c}</b>{p.n}</span>
      ))}
      <div class="hub">
        <Apple id="org" size={64} />
        <span class="mono">Switzerland</span>
      </div>
    </div>
  </div>
</section>

<style>
  .map { position: relative; height: 340px; max-width: 720px; margin: 0 auto; }
  .lines { position: absolute; left: 50%; top: 0; width: 720px; height: 340px; margin-left: -360px; overflow: visible; }
  @media (max-width: 760px) { .lines { display: none; } }
  .ln { fill: none; stroke: var(--hairline); stroke-width: 1.4; stroke-dasharray: 4 5; }
  .node { position: absolute; left: 50%; top: 77%; transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))); display: inline-flex; align-items: center; gap: 8px; background: var(--studio-0); border: 1px solid var(--hairline); border-radius: 999px; padding: 6px 12px 6px 6px; font-size: 13.5px; box-shadow: var(--shadow-2); white-space: nowrap; }
  .node b { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--studio-100); font-size: 11px; font-weight: 500; }
  .head.center .lead { margin-inline: auto; }
  .hub { position: absolute; left: 50%; top: 77%; transform: translate(-50%, -30%); display: grid; justify-items: center; gap: 6px; }
  .hub .mono { font-size: 13px; background: var(--ink); color: #fff; border-radius: 999px; padding: 5px 12px; }
  @media (max-width: 680px) {
    .map { height: 300px; }
    .node { transform: translate(calc(-50% + var(--x) * 0.55), calc(-50% + var(--y) * 0.8)); font-size: 11.5px; padding: 4px 9px 4px 4px; }
    .node b { width: 20px; height: 20px; font-size: 9.5px; }
  }
</style>
